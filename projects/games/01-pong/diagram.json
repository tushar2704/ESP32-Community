{
  "version": 1,
  "author": "Tushar Aggarwal",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "board-ssd1306", "id": "oled", "top": -100, "left": 100, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-pushbutton", "id": "btn_up", "top": -40, "left": -80, "attrs": { "color": "green" } },
    { "type": "wokwi-pushbutton", "id": "btn_down", "top": 40, "left": -80, "attrs": { "color": "red" } },
    { "type": "wokwi-buzzer", "id": "buzzer", "top": 120, "left": 100, "attrs": {} }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:D21", "oled:SDA", "green", [ "h0" ] ],
    [ "esp:D22", "oled:SCL", "blue", [ "h0" ] ],
    [ "esp:3V3", "oled:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "oled:GND", "black", [ "v0" ] ],
    [ "esp:D18", "btn_up:2.1", "green", [ "h0" ] ],
    [ "esp:GND.2", "btn_up:1.1", "black", [ "h0" ] ],
    [ "esp:D19", "btn_down:2.1", "red", [ "h0" ] ],
    [ "esp:GND.2", "btn_down:1.1", "black", [ "h0" ] ],
    [ "esp:D25", "buzzer:2", "yellow", [ "h0" ] ],
    [ "esp:GND.1", "buzzer:1", "black", [ "v0" ] ]
  ]
}

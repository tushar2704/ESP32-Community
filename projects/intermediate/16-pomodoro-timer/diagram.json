{
  "version": 1,
  "author": "Tushar Aggarwal",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "board-ssd1306", "id": "oled", "top": -120, "left": 80, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-pushbutton", "id": "btn", "top": 120, "left": 0, "attrs": { "color": "green", "label": "START/PAUSE" } },
    { "type": "wokwi-buzzer", "id": "bz", "top": -60, "left": -60, "attrs": { "volume": "0.1" } },
    { "type": "wokwi-led", "id": "led", "top": -60, "left": 180, "attrs": { "color": "red" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:GND.1", "oled:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "oled:VCC", "red", [ "v0" ] ],
    [ "esp:22", "oled:SCL", "yellow", [ "v0" ] ],
    [ "esp:21", "oled:SDA", "green", [ "v0" ] ],
    [ "esp:18", "btn:2.1", "green", [ "v0" ] ],
    [ "esp:GND.2", "btn:1.1", "black", [ "v0" ] ],
    [ "esp:19", "bz:2", "purple", [ "v0" ] ],
    [ "esp:GND.1", "bz:1", "black", [ "v0" ] ],
    [ "esp:2", "led:A", "red", [ "v0" ] ],
    [ "esp:GND.1", "led:C", "black", [ "v0" ] ]
  ]
}
